{
  "name": "prowlet-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Solana Anchor registry and API backend for Prowlet",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "anchor build",
    "test": "npm run test:api",
    "test:anchor": "anchor test --provider.cluster localnet",
    "test:program": "ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.ts",
    "test:unit": "cargo test --manifest-path programs/prowlet_registry/Cargo.toml",
    "deploy:devnet": "anchor keys sync --provider.cluster devnet && anchor deploy --provider.cluster devnet && npm run init:devnet",
    "init:devnet": "anchor run initialize",
    "api:dev": "tsx watch src/server.ts",
    "api:start": "node dist/src/server.js",
    "api:build": "tsc -p tsconfig.api.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test:api": "npm run db:migrate && vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^4.3.20",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/yazl": "^3.3.1",
    "chai": "^4.5.0",
    "js-sha3": "^0.9.3",
    "merkletreejs": "^0.6.0",
    "mocha": "^10.8.2",
    "supertest": "^7.0.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "js-sha3": "^0.9.3",
    "jsonwebtoken": "^9.0.2",
    "merkletreejs": "^0.6.0",
    "morgan": "^1.12.1",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
