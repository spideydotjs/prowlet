# HTTP API
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-bytes

# PostgreSQL (create an app database/user; do not reuse postgres superuser)
DATABASE_URL=postgresql://prowlet_app:replace-me@127.0.0.1:5435/prowlet
DATABASE_SSL=false

# Solana. Keep the keypair file outside source control and restrict permissions.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=/absolute/path/to/solana-keypair.json
BLOCKCHAIN_MODE=mock
PROGRAM_ID=Hi76RFfVSD82bW3KLhUYWw5rLRf4xVLrS5JzdYEgKdcB
FRONTEND_PUBLIC_URL=http://localhost:3000
UPLOAD_DIR=./storage
MAX_BATCH_SIZE=1000
ADMIN_EMAIL=admin@prowlet.local
ADMIN_PASSWORD=change-this-before-use
